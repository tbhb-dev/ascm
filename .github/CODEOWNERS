# Review routing for ascm. GitHub applies the last matching rule, so the
# supply-chain rules below override the default for the paths they name.

# Default owner for everything.
*           @tbhb

# Supply-chain and CI surface. The /.github/ rule already covers
# renovate.json5 and every workflow, so neither needs its own line.
/.github/       @tbhb
/go.mod         @tbhb
/go.sum         @tbhb
/vendor/        @tbhb
/.golangci.yml   @tbhb
/.go-arch-lint.yml @tbhb
/.testcoverage.yml @tbhb
/.gremlins.yaml  @tbhb
/mise.toml      @tbhb
/mise.lock      @tbhb
