{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#832ee9496f7d6e270823dcf4ef4794514ae75e4c", // main
    "github>tbhb-dev/renovate-config//bazel.json5#832ee9496f7d6e270823dcf4ef4794514ae75e4c", // main
    "github>tbhb-dev/renovate-config//go.json5#832ee9496f7d6e270823dcf4ef4794514ae75e4c", // main
  ],

  // ascm needs nothing beyond the presets: its Go module and Bazel pins are
  // both covered there.
}
