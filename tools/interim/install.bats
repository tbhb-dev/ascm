#!/usr/bin/env bats
# SPDX-License-Identifier: Apache-2.0
# Copyright Tony Burns

# Tests for tools/interim/install.sh, which installs the prek git hook shims
# and the plain agent identity hooks.
# prek is stubbed: the tests check what install.sh asks of it, not prek itself.

bats_require_minimum_version 1.5.0

setup() {
	SCRIPT="${BATS_TEST_DIRNAME}/install.sh"
	# Isolate git from the user's and the harness's configuration. Harnesses
	# inject GIT_AUTHOR_*, GIT_COMMITTER_* and GIT_CONFIG_* into agent shells.
	local names v
	names=$(compgen -e)
	for v in $names; do
		[[ $v == GIT_* ]] && unset "$v"
	done
	export HOME="${BATS_TEST_TMPDIR}/home"
	export GIT_CONFIG_NOSYSTEM=1
	export GIT_CONFIG_GLOBAL="${BATS_TEST_TMPDIR}/global.gitconfig"
	mkdir -p "$HOME"
	: >"$GIT_CONFIG_GLOBAL"
	# Each run of install.sh gets a PATH holding only what it needs, so a real
	# prek or mise on the developer's machine never leaks in.
	STUBS="${BATS_TEST_TMPDIR}/stubs"
	CALLS="${BATS_TEST_TMPDIR}/calls"
	mkdir -p "$STUBS"
	local tool target
	for tool in env git bash mkdir chmod rm mv cat dirname; do
		target=$(command -v "$tool")
		ln -s "$target" "${STUBS}/${tool}"
	done
	export CALLS
	REPO="${BATS_TEST_TMPDIR}/repo"
	git init -q "$REPO"
	cd "$REPO" || return
}

# stub <name>: a stand-in that appends its name and arguments to $CALLS.
stub() {
	# shellcheck disable=SC2016 # $* and $CALLS expand when the stub runs
	printf '#!/bin/sh\necho "%s $*" >>"$CALLS"\n' "$1" >"${STUBS}/$1"
	chmod +x "${STUBS}/$1"
}

EXPECTED="install --hook-type pre-commit --hook-type pre-push"
HOOKS=(prepare-commit-msg:trailer commit-msg:check post-commit:consume)
# The prek calls of one run whose config has no identity-stage hooks.
calls() {
	printf '%s\n' "$1 ${EXPECTED}" "$1 list --hook-stage prepare-commit-msg" \
		"$1 list --hook-stage commit-msg" "$1 list --hook-stage post-commit"
}

# prek_with_stage <stage>: a prek stand-in whose config has hooks for <stage>
# only; `install --hook-type <stage>` writes a prek-style shim that records
# its arguments in $CALLS.
prek_with_stage() {
	cat >"${STUBS}/prek" <<STUB
#!/bin/sh
echo "prek \$*" >>"\$CALLS"
if [ "\$*" = "list --hook-stage $1" ]; then echo ".:cog"; fi
if [ "\$*" = "install --hook-type $1" ]; then
	printf '#!/bin/sh\\n# File generated by prek\\necho "prek-shim \$\$*" >>"\$\$CALLS"\\n' >.git/hooks/$1
	chmod +x .git/hooks/$1
fi
STUB
	chmod +x "${STUBS}/prek"
}

@test "installs pre-commit and pre-push through prek" {
	stub prek
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	[ "$output" = "install.sh: installed git hooks" ]
	local want
	want=$(calls prek)
	run cat "$CALLS"
	[ "$output" = "$want" ]
}

@test "is idempotent" {
	stub prek
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	run cat "$CALLS"
	[ "${lines[0]}" = "prek ${EXPECTED}" ]
	[ "${lines[4]}" = "prek ${EXPECTED}" ]
}

@test "falls back to mise exec when prek is not on PATH" {
	stub mise
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	local want
	want=$(calls "mise exec -- prek")
	run cat "$CALLS"
	[ "$output" = "$want" ]
}

@test "prefers prek over mise" {
	stub prek
	stub mise
	run env PATH="$STUBS" "$SCRIPT"
	local want
	want=$(calls prek)
	run cat "$CALLS"
	[ "$output" = "$want" ]
}

@test "fails clearly when neither prek nor mise exists" {
	run --separate-stderr env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 1 ]
	[ -z "$output" ]
	[ "$stderr" = "install.sh: error: prek not found; run it through 'uv run' (prek is in the uv dev group)" ]
}

@test "warns and stops when a local core.hooksPath is set" {
	stub prek
	git config --local core.hooksPath custom/hooks
	run --separate-stderr env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	[ -z "$output" ]
	[ "$stderr" = "install.sh: warning: core.hooksPath is custom/hooks; not installing prek hooks" ]
	[ ! -e "$CALLS" ]
	run git config --local core.hooksPath
	[ "$output" = "custom/hooks" ]
}

@test "warns when core.hooksPath is set globally and leaves it alone" {
	stub prek
	git config --global core.hooksPath /global/hooks
	run --separate-stderr env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	[ "$stderr" = "install.sh: warning: core.hooksPath is /global/hooks; not installing prek hooks" ]
	[ ! -e "$CALLS" ]
	run git config --global core.hooksPath
	[ "$output" = "/global/hooks" ]
}

@test "does not set core.hooksPath itself" {
	stub prek
	run env PATH="$STUBS" "$SCRIPT"
	run git config --get core.hooksPath
	[ "$status" -eq 1 ]
}

@test "reports a prek failure" {
	printf '#!/bin/sh\nexit 3\n' >"${STUBS}/prek"
	chmod +x "${STUBS}/prek"
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 3 ]
}

@test "writes plain identity hooks that never go through prek" {
	stub prek
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	local pair hook
	for pair in "${HOOKS[@]}"; do
		hook=".git/hooks/${pair%%:*}"
		[ -x "$hook" ]
		run cat "$hook"
		[ "${lines[0]}" = "#!/bin/sh" ]
		[ "${lines[1]}" = "# ascm interim agent identity hook (tools/interim/install.sh)" ]
		[ "${lines[2]}" = "uv run --no-project --quiet --python \">=3.15\" python tools/interim/agent_identity.py ${pair#*:} \"\$@\"" ]
		[ "${lines[4]}" = "next=\"\$(dirname \"\$0\")/${pair%%:*}.prek\"" ]
		[ ! -e "${hook}.prek" ]
	done
}

@test "chains prek's own shim only for a stage whose config has hooks" {
	prek_with_stage commit-msg
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	[ -x .git/hooks/commit-msg.prek ]
	run cat .git/hooks/commit-msg.prek
	[ "${lines[1]}" = "# File generated by prek" ]
	[ ! -e .git/hooks/prepare-commit-msg.prek ]
	[ ! -e .git/hooks/post-commit.prek ]
	run cat .git/hooks/commit-msg
	[ "${lines[1]}" = "# ascm interim agent identity hook (tools/interim/install.sh)" ]
	run grep -c "install --hook-type commit-msg" "$CALLS"
	[ "$output" = 1 ]
}

@test "drops a stale prek shim once the stage has no hooks" {
	prek_with_stage commit-msg
	run env PATH="$STUBS" "$SCRIPT"
	stub prek
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	[ ! -e .git/hooks/commit-msg.prek ]
}

@test "treats a failing prek list (no config) as no hooks" {
	# shellcheck disable=SC2016 # $1 expands when the stub runs
	printf '#!/bin/sh\ncase "$1" in list) echo nope >&2; exit 2;; esac\n' >"${STUBS}/prek"
	chmod +x "${STUBS}/prek"
	run --separate-stderr env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	[ -z "$stderr" ]
	[ ! -e .git/hooks/commit-msg.prek ]
	[ -x .git/hooks/commit-msg ]
}

# run_hook <identity exit> <prek exit>: run the installed commit-msg hook with a
# stand-in uv and a stand-in prek shim; both record that they ran.
run_hook() {
	# shellcheck disable=SC2016 # $* and $CALLS expand when the stand-ins run
	printf '#!/bin/sh\necho "uv $*" >>"$CALLS"\nexit %s\n' "$1" >"${STUBS}/uv"
	chmod +x "${STUBS}/uv"
	# shellcheck disable=SC2016 # as above
	printf '#!/bin/sh\necho "prek-shim $*" >>"$CALLS"\nexit %s\n' "$2" >.git/hooks/commit-msg.prek
	chmod +x .git/hooks/commit-msg.prek
	: >"$CALLS"
	run env PATH="$STUBS" .git/hooks/commit-msg MSG
}

# ran_both: $CALLS shows the identity step, then the prek shim.
ran_both() {
	local got
	got=$(<"$CALLS")
	[ "$got" = "$expected" ]
}

@test "the hook runs the identity step and then prek, and either fails it" {
	stub prek
	run env PATH="$STUBS" "$SCRIPT"
	local expected
	expected=$(printf '%s\n' \
		'uv run --no-project --quiet --python >=3.15 python tools/interim/agent_identity.py check MSG' \
		'prek-shim MSG')
	run_hook 0 0
	[ "$status" -eq 0 ]
	ran_both
	run_hook 1 0
	[ "$status" -eq 1 ]
	ran_both
	run_hook 0 4
	[ "$status" -eq 4 ]
	run_hook 1 4
	[ "$status" -eq 4 ]
	ran_both
	# Without a prek shim only the identity step runs, and its status is final.
	rm .git/hooks/commit-msg.prek
	: >"$CALLS"
	run env PATH="$STUBS" .git/hooks/commit-msg MSG
	[ "$status" -eq 1 ]
	run cat "$CALLS"
	[ "$output" = "${expected%$'\n'*}" ]
}

@test "replaces prek shims and its own hooks, keeps anything else" {
	stub prek
	mkdir -p .git/hooks
	printf '#!/bin/sh\n# File generated by prek: x\n' >.git/hooks/prepare-commit-msg
	printf '#!/bin/sh\necho mine\n' >.git/hooks/commit-msg
	run --separate-stderr env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	local hooks
	hooks=$(git rev-parse --path-format=absolute --git-path hooks)
	[ "$stderr" = "install.sh: warning: ${hooks}/commit-msg is not ours; leaving it" ]
	run cat .git/hooks/commit-msg
	[ "$output" = $'#!/bin/sh\necho mine' ]
	run cat .git/hooks/prepare-commit-msg
	[ "${lines[1]}" = "# ascm interim agent identity hook (tools/interim/install.sh)" ]
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	run cat .git/hooks/post-commit
	[ "${lines[1]}" = "# ascm interim agent identity hook (tools/interim/install.sh)" ]
}

@test "installs the identity hooks into the shared hooks directory from a worktree" {
	stub prek
	git -c user.name=T -c user.email=t@example.invalid commit -q --allow-empty -m init
	git worktree add -q ../wt
	cd ../wt || return
	run env PATH="$STUBS" "$SCRIPT"
	[ "$status" -eq 0 ]
	[ -x "${REPO}/.git/hooks/commit-msg" ]
}
